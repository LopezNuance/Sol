{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/qry/schemas/qry_execution.schema.json",
  "title": "QRY Query Execution Record v0.3",
  "type": "object",
  "required": ["schema_version", "query_run_id", "query_ref", "query_digest", "source_manifest", "status"],
  "properties": {
    "schema_version": {"const": "qry.execution.v0.3"},
    "query_run_id": {"type": "string", "minLength": 1},
    "query_ref": {"type": "string", "minLength": 1},
    "query_digest": {"type": "string", "pattern": "^digest:sha256:[0-9a-f]{64}$"},
    "source_manifest": {"type": "string", "pattern": "^object:sha256:[0-9a-f]{64}$"},
    "actor_id": {"type": "string"},
    "status": {
      "enum": ["success", "complete", "incomplete_with_continuation", "failed", "cancelled"]
    },
    "continuation": {
      "type": ["object", "null"],
      "required": ["token"],
      "properties": {
        "token": {"type": "string"},
        "query_digest": {"type": "string", "pattern": "^digest:sha256:[0-9a-f]{64}$"},
        "source_manifest": {"type": "string", "pattern": "^object:sha256:[0-9a-f]{64}$"},
        "partial_result_object": {"type": "string"}
      },
      "additionalProperties": false
    },
    "guarantee": {
      "type": ["object", "null"],
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["exact", "lower_bound", "upper_bound", "bounded", "heuristic"]},
        "result_object": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "assurance": {
      "type": ["object", "null"],
      "required": ["status"],
      "properties": {
        "status": {"enum": ["proven", "validated", "contract_asserted", "tested", "unaudited", "unknown"]},
        "effective_status": {"enum": ["proven", "validated", "contract_asserted", "tested", "unaudited", "unknown"]},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "depends_on": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "provenance_mode": {"enum": ["none", "tuple", "why", "how", "full_graph"]},
    "started_at": {"type": "string"},
    "completed_at": {"type": "string"},
    "rows_returned": {"type": "integer", "minimum": 0},
    "resource_usage": {
      "type": "object",
      "properties": {
        "records_read": {"type": "integer", "minimum": 0},
        "object_bytes_read": {"type": "integer", "minimum": 0},
        "semantic_evaluations": {"type": "integer", "minimum": 0},
        "wall_time_ms": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "logical_rewrites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id"],
        "properties": {
          "rule_id": {"type": "string"},
          "location": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "policies": {
      "type": "object",
      "properties": {
        "visibility_policy": {"type": "string"},
        "authorization_policy": {"type": "string"},
        "leakage_policy": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
